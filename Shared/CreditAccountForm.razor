@* Formulario compartido entre el alta y la edición de tarjetas: la API pide
   exactamente los mismos campos en ambos casos (el PUT es reemplazo total). *@

<EditForm Model="Model" OnValidSubmit="OnValidSubmit" FormName="credit-account">
    <DataAnnotationsValidator />
    <Alert Message="@Error" />

    <label class="field">
        <span class="field-label">Nombre</span>
        <InputTextLive @bind-Value="Model.Name" class="input" placeholder="Tarjeta Oro BBVA" />
        <span class="field-hint">Entre 8 y 35 caracteres.</span>
        <ValidationMessage For="() => Model.Name" />
    </label>

    <label class="field">
        <span class="field-label">Descripción <span class="field-hint">(opcional)</span></span>
        <InputTextAreaLive @bind-Value="Model.Description" class="input" rows="2" />
    </label>

    <label class="field">
        <span class="field-label">Banco</span>
        <InputSelect @bind-Value="Model.BankId" class="input">
            <option value="">Selecciona…</option>
            @foreach (var bank in Banks)
            {
                <option value="@bank.Id">@bank.Name</option>
            }
        </InputSelect>
        <ValidationMessage For="() => Model.BankId" />
    </label>

    <div class="field-row">
        <label class="field">
            <span class="field-label">Límite de crédito</span>
            <InputNumberLive @bind-Value="Model.CreditLimit" class="input" inputmode="decimal" step="0.01" />
            <ValidationMessage For="() => Model.CreditLimit" />
        </label>

        <label class="field">
            <span class="field-label">Tasa anual (%)</span>
            <InputNumberLive @bind-Value="Model.InterestRate" class="input" inputmode="decimal" step="0.01" />
            <ValidationMessage For="() => Model.InterestRate" />
        </label>
    </div>

    <div class="field-row">
        <label class="field">
            <span class="field-label">Día de corte</span>
            <InputNumberLive @bind-Value="Model.CutDay" class="input" min="1" max="31" />
            <ValidationMessage For="() => Model.CutDay" />
        </label>

        <label class="field">
            <span class="field-label">Día de pago</span>
            <InputNumberLive @bind-Value="Model.PayDay" class="input" min="1" max="31" />
            <ValidationMessage For="() => Model.PayDay" />
        </label>
    </div>

    @if (ShowArchiveToggle)
    {
        <label class="field field-inline">
            <InputCheckbox @bind-Value="Model.IsArchived" class="checkbox" />
            <span>
                <span class="field-label">Archivar tarjeta</span>
                <span class="field-hint">Deja de aparecer en los selectores, pero conserva su historial.</span>
            </span>
        </label>
    }

    <button class="btn btn-primary btn-block" type="submit" disabled="@Busy">
        @(Busy ? "Guardando…" : SubmitText)
    </button>
</EditForm>

@code {
    [Parameter, EditorRequired] public SaveCreditAccountRequest Model { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<BankDto> Banks { get; set; } = [];
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool ShowArchiveToggle { get; set; } = true;
    [Parameter] public string SubmitText { get; set; } = "Guardar";
    [Parameter] public EventCallback OnValidSubmit { get; set; }
}
