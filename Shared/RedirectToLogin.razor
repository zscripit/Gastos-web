@inject NavigationManager Nav

@code {
    // Manda al login conservando a dónde quería entrar el usuario, para
    // devolverlo ahí en cuanto se autentique.
    protected override void OnInitialized()
    {
        var target = Uri.EscapeDataString(
            Nav.ToBaseRelativePath(Nav.Uri));

        Nav.NavigateTo($"login?returnUrl={target}", replace: true);
    }
}
