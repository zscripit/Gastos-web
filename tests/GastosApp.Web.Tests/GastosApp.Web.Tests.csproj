<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas unitarias white box del cliente (Práctica 11).
    El código bajo prueba se compila en ../ClientUnderTest (archivos fuente enlazados del cliente), un
    ensamblado aparte para que la cobertura lo mida: la herramienta excluye el ensamblado de pruebas.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>GastosApp.Web.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ClientUnderTest/ClientUnderTest.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
