@inherits LayoutComponentBase
@implements IDisposable
@inject ApiClient Api
@inject AuthService Auth
@inject NavigationManager Nav

@* La navegación es un único bloque de marcado: en teléfono el CSS la pinta
   como barra inferior y en escritorio como barra lateral. Así no hay dos
   árboles que mantener sincronizados ni saltos al cambiar de tamaño. *@

<div class="app-shell">
    <AuthorizeView>
        <Authorized>
            <nav class="nav" aria-label="Navegación principal">
                <div class="nav-brand">
                    <span class="nav-brand-mark"><Icon Name="coins" Size="18" /></span>
                    <span class="nav-brand-name">Gastos</span>
                </div>

                <div class="nav-items">
                    <NavLink class="tab" href="inicio">
                        <span class="tab-icon"><Icon Name="home" /></span>
                        <span class="tab-label">Inicio</span>
                    </NavLink>
                    <NavLink class="tab" href="cuentas">
                        <span class="tab-icon"><Icon Name="wallet" /></span>
                        <span class="tab-label">Cuentas</span>
                    </NavLink>
                    <NavLink class="tab" href="categorias">
                        <span class="tab-icon"><Icon Name="tag" /></span>
                        <span class="tab-label">Categorías</span>
                    </NavLink>
                    <NavLink class="tab" href="perfil">
                        <span class="tab-icon"><Icon Name="user" /></span>
                        <span class="tab-label">Perfil</span>
                    </NavLink>
                </div>

                <div class="nav-footer">
                    <button class="nav-signout" type="button" @onclick="LogoutAsync">
                        <Icon Name="signout" Size="17" />
                        <span>Cerrar sesión</span>
                    </button>
                </div>
            </nav>
        </Authorized>
    </AuthorizeView>

    <main class="app-main">
        <div class="app-content" @key="_routeKey">
            @Body
        </div>
    </main>
</div>

@code {
    // Cambiar la clave en cada navegación vuelve a montar el contenido, que es
    // lo que dispara la animación de entrada de la pantalla.
    private string _routeKey = string.Empty;

    protected override void OnInitialized()
    {
        Api.Unauthorized += HandleUnauthorizedAsync;
        Nav.LocationChanged += OnLocationChanged;
        _routeKey = Nav.Uri;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _routeKey = e.Location;
        StateHasChanged();
    }

    // Si la API rechaza el token (expirado o revocado) se limpia la sesión y
    // se manda al login, en vez de dejar la app mostrando pantallas vacías.
    private async Task HandleUnauthorizedAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("login", replace: true);
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("login", replace: true);
    }

    public void Dispose()
    {
        Api.Unauthorized -= HandleUnauthorizedAsync;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
