@inherits LayoutComponentBase
@implements IDisposable
@inject ApiClient Api
@inject AuthService Auth
@inject NavigationManager Nav

@* La navegación es un único bloque de marcado: en teléfono el CSS la pinta
   como barra inferior y en escritorio como barra lateral. Así no hay dos
   árboles que mantener sincronizados ni saltos al cambiar de tamaño. *@

<div class="app-shell">
    <AuthorizeView>
        <Authorized Context="auth">
            @{ var isAdmin = auth.User.IsSystemAdmin(); }
            <nav class="nav @(isAdmin ? "nav-admin" : null)" aria-label="Navegación principal">
                <div class="nav-brand">
                    <span class="nav-brand-mark"><Icon Name="@(isAdmin ? "shield" : "coins")" Size="18" /></span>
                    <span>
                        <span class="nav-brand-name">Gastos</span>
                        @if (isAdmin)
                        {
                            <span class="nav-brand-role">Administración</span>
                        }
                    </span>
                </div>

                <div class="nav-items">
                    @if (isAdmin)
                    {
                        @* El SuperAdmin sólo administra catálogos del sistema: no tiene
                           resumen, cuentas ni categorías propias. *@
                        <NavLink class="tab" href="admin/bancos">
                            <span class="tab-icon"><Icon Name="bank" /></span>
                            <span class="tab-label">Bancos</span>
                        </NavLink>
                        <NavLink class="tab" href="admin/proveedores">
                            <span class="tab-icon"><Icon Name="plug" /></span>
                            <span class="tab-label">Proveedores</span>
                        </NavLink>
                    }
                    else
                    {
                        <NavLink class="tab" href="inicio">
                            <span class="tab-icon"><Icon Name="home" /></span>
                            <span class="tab-label">Inicio</span>
                        </NavLink>
                        <NavLink class="tab" href="cuentas">
                            <span class="tab-icon"><Icon Name="wallet" /></span>
                            <span class="tab-label">Cuentas</span>
                        </NavLink>
                        <NavLink class="tab" href="movimientos">
                            <span class="tab-icon"><Icon Name="coins" /></span>
                            <span class="tab-label">Movimientos</span>
                        </NavLink>
                        <NavLink class="tab" href="servicios">
                            <span class="tab-icon"><Icon Name="plug" /></span>
                            <span class="tab-label">Servicios</span>
                        </NavLink>
                        <NavLink class="tab" href="planes">
                            <span class="tab-icon"><Icon Name="card" /></span>
                            <span class="tab-label">A meses</span>
                        </NavLink>
                        <NavLink class="tab" href="categorias">
                            <span class="tab-icon"><Icon Name="tag" /></span>
                            <span class="tab-label">Categorías</span>
                        </NavLink>
                    }
                    <NavLink class="tab" href="perfil">
                        <span class="tab-icon"><Icon Name="user" /></span>
                        <span class="tab-label">Perfil</span>
                    </NavLink>
                </div>

                <div class="nav-footer">
                    <button class="nav-signout" type="button" @onclick="LogoutAsync">
                        <Icon Name="signout" Size="17" />
                        <span>Cerrar sesión</span>
                    </button>
                </div>
            </nav>
        </Authorized>
    </AuthorizeView>

    <main class="app-main">
        @* La clave se lee de la URL en el mismo render en que el router cambia
           de página, así que cada navegación monta la pantalla una sola vez (y
           dispara su animación de entrada). Actualizarla desde LocationChanged
           la montaba dos veces: una el router y otra el cambio de clave, con
           lo que cada pantalla pedía sus datos a la API por duplicado. *@
        <div class="app-content" @key="Nav.Uri">
            @Body
        </div>
    </main>
</div>

@code {
    protected override void OnInitialized() => Api.Unauthorized += HandleUnauthorizedAsync;

    // Si la API rechaza el token (expirado o revocado) se limpia la sesión y
    // se manda al login, en vez de dejar la app mostrando pantallas vacías.
    private async Task HandleUnauthorizedAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("login", replace: true);
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("login", replace: true);
    }

    public void Dispose() => Api.Unauthorized -= HandleUnauthorizedAsync;
}
