@page "/servicios"
@attribute [Authorize(Policy = Policies.Operational)]
@inject OperationsService Operations
@inject CatalogService Catalog

<PageTitle>Servicios · Gastos</PageTitle>
<header class="page-header"><h1>Servicios</h1><p class="page-subtitle">Organiza tus servicios y sus proveedores.</p></header>
<Alert Message="@_error" />
@if (_loading) { <LoadingBlock /> }
else
{
    <button class="btn btn-primary" type="button" @onclick="New" disabled="@_busy">Agregar servicio</button>
    @if (_form is not null)
    {
        <section class="section card operation-form">
            <h2 class="section-title">@(_id is null ? "Nuevo servicio" : "Editar servicio")</h2>
            <EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="service">
                <DataAnnotationsValidator /><ValidationSummary />
                <fieldset disabled="@_busy">
                    <label class="field"><span class="field-label">Nombre</span><InputTextLive class="input" @bind-Value="_form.Name" maxlength="30" /></label>
                    <label class="field"><span class="field-label">Descripción</span><InputTextAreaLive class="input" @bind-Value="_form.Description" /></label>
                    @if (_id is null)
                    {
                        <label class="field"><span class="field-label">Tipo de servicio</span><InputSelect class="input" @bind-Value="_form.ServiceType">@foreach (var type in Enum.GetValues<ServiceType>()) { <option value="@type">@Label(type)</option> }</InputSelect></label>
                        <label class="field"><span class="field-label">Proveedor</span><InputSelect class="input" @bind-Value="_form.ProviderId"><option value="">Selecciona…</option>@foreach (var provider in _providers) { <option value="@provider.Id">@provider.Name</option> }</InputSelect></label>
                        @if (_providers.Count == 0) { <p>No hay proveedores activos. El administrador debe agregar uno.</p> }
                    }
                    else
                    {
                        <p class="field-hint">El tipo y proveedor se conservan al editar.</p>
                        <label class="field field-inline"><InputCheckbox @bind-Value="_form.IsArchived" /><span>Archivar servicio</span></label>
                    }
                    <div class="operation-actions"><button class="btn btn-primary" type="submit">@(_busy ? "Guardando…" : "Guardar")</button><button class="btn btn-secondary" type="button" @onclick="Cancel">Cancelar</button></div>
                </fieldset>
            </EditForm>
        </section>
    }
    <label class="field field-inline"><input type="checkbox" @bind="_showArchived" /><span>Mostrar archivados</span></label>
    @if (!Visible.Any()) { <EmptyState Title="Sin servicios" Description="Agrega tus servicios de internet, luz o suscripciones." /> }
    else
    {
        <ul class="list">@foreach (var item in Visible)
        {
            <li class="list-item"><div class="list-lead"><Glyph Name="@item.ProviderName" IconUrl="@item.ProviderIconUrl" /><div><p class="list-title">@item.Name @if (item.IsArchived) { <span class="badge">Archivado</span> }</p><p class="list-subtitle">@item.ProviderName · @Label(item.ServiceType)</p><p class="list-subtitle">@item.Description</p></div></div><button class="btn btn-secondary" type="button" disabled="@_busy" @onclick="() => Edit(item)">Editar</button></li>
        }</ul>
    }
}
@code {
    private List<ServiceDto> _items = [];
    private IReadOnlyList<ProviderDto> _providers = [];
    private ServiceForm? _form;
    private Guid? _id;
    private bool _loading = true, _busy, _showArchived;
    private string? _error;
    private IEnumerable<ServiceDto> Visible => _items.Where(x => _showArchived || !x.IsArchived);
    protected override async Task OnInitializedAsync()
    {
        var providers = await Catalog.GetActiveProvidersAsync();
        _providers = providers.Data ?? [];
        await ReloadAsync();
        if (!providers.Success) _error = providers.Error;
        _loading = false;
    }
    private async Task ReloadAsync()
    {
        var result = await Operations.ServicesAsync();
        if (result.Success) _items = result.Data ?? [];
        else _error = result.Error;
    }
    private void New() { _id = null; _form = new(); _error = null; }
    private void Cancel() { _form = null; _id = null; }
    private void Edit(ServiceDto item)
    {
        _id = item.Id; _error = null;
        _form = new() { Name = item.Name, Description = item.Description, IsArchived = item.IsArchived, ProviderId = item.ProviderId, ServiceType = item.ServiceType };
    }
    private async Task SaveAsync()
    {
        if (_busy || _form is null) return;
        if (_id is null && (_form.ProviderId is null || _form.ProviderId == Guid.Empty)) { _error = "Selecciona un proveedor."; return; }
        _busy = true; _error = null;
        try
        {
            var result = await Operations.SaveServiceAsync(_form, _id);
            if (result.Success) { Cancel(); await ReloadAsync(); }
            else _error = result.Error + " " + string.Join(" ", result.ValidationErrors.Values.SelectMany(x => x));
        }
        finally { _busy = false; }
    }
    private static string Label(ServiceType type) => System.Text.RegularExpressions.Regex.Replace(type.ToString(), "([a-z])([A-Z])", "$1 $2");
}
