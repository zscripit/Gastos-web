@page "/inicio"
@attribute [Authorize(Policy = Policies.Operational)]
@inject AccountService Accounts
@inject OperationsService Operations
@inject AnalyticsService Analytics

<PageTitle>Inicio · Gastos</PageTitle>

<header class="page-header">
    <h1>Resumen</h1>
    <p class="page-subtitle">@CultureInfo.CurrentCulture.TextInfo.ToTitleCase(DateTime.Now.ToString("dddd d 'de' MMMM"))</p>
</header>

@if (_loading)
{
    <div class="dashboard">
    <section class="section">
        <h2 class="section-title">Próximos pagos de tarjeta</h2>
        <div class="card-list"><Skeleton Variant="card" Count="2" /></div>
    </section>
    <section class="section">
        <h2 class="section-title">Otras cuentas</h2>
        <div class="list"><Skeleton Variant="row" Count="2" /></div>
    </section>
    </div>
}
else if (_error is not null)
{
    <Alert Message="@_error" />
}
else
{
    @* Resumen del mes: carga aparte para no retrasar los pagos, que son lo urgente. Si falla, no se muestra. *@
    @if (_monthly is not null || _commitments is not null)
    {
        <a class="month-summary card" href="analisis">
            @if (_monthly?.CurrentMonth is { } month)
            {
                <div>
                    <p class="account-figure-label">Gasto del mes</p>
                    <p class="stat-figure">@month.SpentToDate.ToString("C0")</p>
                    <p class="list-subtitle">
                        Proyección @month.Projected.ToString("C0")
                        @if (month.ChangeVsPrevious is decimal change)
                        {
                            <text> </text><span class="@(change > 0.1m ? "text-warning" : change < -0.1m ? "text-accent" : null)">· @(change >= 0 ? "▲" : "▼") @Math.Abs(change).ToString("P0") vs. mes anterior</span>
                        }
                    </p>
                </div>
            }
            @if (_commitments?.Months.Skip(1).FirstOrDefault() is { } next)
            {
                <div>
                    <p class="account-figure-label">Cuotas a meses en @next.Month.ToString("MMMM")</p>
                    <p class="stat-figure">@next.Total.ToString("C0")</p>
                    <p class="list-subtitle">@next.Plans.Count @(next.Plans.Count == 1 ? "compra" : "compras")</p>
                </div>
            }
            <span class="month-summary-link">Ver análisis ›</span>
        </a>
    }

    <div class="dashboard">
    <section class="section">
        <h2 class="section-title">Próximos pagos de tarjeta</h2>

        @if (_cards.Count == 0)
        {
            <EmptyState Title="Sin tarjetas registradas"
                        Description="Agrega una tarjeta para llevar el control de su corte y su fecha de pago.">
                <a class="btn btn-primary" href="cuentas/nueva?tipo=credito">
                    <Icon Name="plus" Size="17" /> Agregar tarjeta
                </a>
            </EmptyState>
        }
        else
        {
            <div class="card-list">
                @foreach (var card in _cards)
                {
                    <a class="credit-card" href="@($"cuentas/{card.Id}/saldo")">
                        <div class="credit-card-head">
                            <span class="credit-card-bank">
                                <Icon Name="card" Size="14" />
                                @card.BankName
                            </span>
                            <span class="badge badge-@PaymentTone(card)">@PaymentLabel(card)</span>
                        </div>

                        <div class="credit-card-body">
                            <div>
                                <p class="credit-card-name">@card.Name</p>
                                <p class="list-subtitle">Deuda @((-card.Balance).ToString("C2"))</p>
                                <p class="list-subtitle">Disponible @card.AvailableCredit?.ToString("C2")</p>
                            </div>
                            <CycleRing Progress="card.CycleProgress" DaysRemaining="card.DaysUntilPayment" />
                        </div>

                        <dl class="credit-card-meta">
                            <div>
                                <dt>Corte</dt>
                                <dd>@card.CutDate?.ToString("dd MMM")</dd>
                            </div>
                            <div>
                                <dt>Pago</dt>
                                <dd>@card.PayDate?.ToString("dd MMM")</dd>
                            </div>
                            <div>
                                <dt>Tasa</dt>
                                <dd>@card.InterestRate?.ToString("0.#")%</dd>
                            </div>
                        </dl>
                    </a>
                }
            </div>
        }
    </section>

    <section class="section">
        <h2 class="section-title">Otras cuentas</h2>

        @if (_others.Count == 0)
        {
            <EmptyState Title="Sin cuentas de débito, ahorro o efectivo"
                        Description="Regístralas para separar de dónde sale cada gasto.">
                <a class="btn btn-secondary" href="cuentas/nueva">
                    <Icon Name="plus" Size="17" /> Agregar cuenta
                </a>
            </EmptyState>
        }
        else
        {
            <ul class="list">
                @foreach (var account in _others)
                {
                    <li class="list-item">
                        <div class="list-lead">
                            <Glyph Name="@account.BankName" IconUrl="@account.BankIconUrl" />
                            <div>
                                <a class="list-title" href="@($"cuentas/{account.Id}/saldo")">@account.Name</a>
                                <p class="list-subtitle">Saldo @account.Balance.ToString("C2")</p>
                                <p class="list-subtitle">@account.BankName · @account.AccountType.DisplayName()</p>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
    </div>
}

@code {
    private List<ActiveAccountDto> _cards = [];
    private List<ActiveAccountDto> _others = [];
    private bool _loading = true;
    private string? _error;
    private MonthlySpendingDto? _monthly;
    private CommitmentsDto? _commitments;

    protected override async Task OnInitializedAsync()
    {
        _ = LoadSummaryAsync();
        var result = await Accounts.GetActiveAsync();

        if (!result.Success)
        {
            _error = result.Error;
        }
        else
        {
            var accounts = result.Data ?? [];
            foreach (var card in accounts.Where(a => a.IsCredit))
            {
                var balance = await Operations.BalanceAsync(card.Id);
                if (!balance.Success) { _error = balance.Error; break; }
                if (balance.Data?.CurrentPeriod is { } period)
                {
                    card.CutDate = new DateTimeOffset(period.CutDate.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero);
                    card.PayDate = new DateTimeOffset(period.PaymentDueDate.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero);
                }
            }
            // Las tarjetas se ordenan por urgencia de pago: es la información
            // que motiva abrir la app.
            _cards = accounts.Where(a => a.IsCredit)
                             .OrderBy(a => a.DaysUntilPayment ?? int.MaxValue)
                             .ToList();
            _others = accounts.Where(a => !a.IsCredit)
                              .OrderBy(a => a.Name)
                              .ToList();
        }

        _loading = false;
    }

    private async Task LoadSummaryAsync()
    {
        var monthly = Analytics.MonthlyAsync(2);
        var commitments = Analytics.CommitmentsAsync(2);
        _monthly = (await monthly).Data;
        _commitments = (await commitments).Data;
        StateHasChanged();
    }

    private static string PaymentLabel(ActiveAccountDto card) => card.DaysUntilPayment switch
    {
        null => "Sin fecha",
        < 0 => "Vencida",
        0 => "Paga hoy",
        1 => "Mañana",
        var days => $"En {days} días"
    };

    private static string PaymentTone(ActiveAccountDto card) => card.DaysUntilPayment switch
    {
        null => "neutral",
        < 0 => "danger",
        <= 3 => "warning",
        _ => "neutral"
    };
}
