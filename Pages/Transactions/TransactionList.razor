@page "/movimientos"
@attribute [Authorize(Policy = Policies.Operational)]
@inject OperationsService Operations
@inject AccountService Accounts
@inject CategoryService Categories
@inject OfflineSync Sync
@implements IDisposable

<PageTitle>Movimientos · Gastos</PageTitle>
<header class="page-header"><h1>Movimientos</h1><p class="page-subtitle">Ingresos, gastos y pagos de tarjeta.</p></header>
<Alert Message="@_error" />
<Alert Message="@_info" Kind="info" />
@if (_loading) { <LoadingBlock /> }
else
{
    <div class="operation-actions"><button class="btn btn-primary" type="button" disabled="@_busy" @onclick="New">Registrar movimiento</button><a class="btn btn-secondary" href="planes">Compras a meses</a></div>
    @if (_detail is { } detail)
    {
        <section class="section card operation-form operation-detail" tabindex="-1" @ref="_panel" aria-label="Detalle del movimiento">
            <h2 class="section-title">Detalle del movimiento</h2>
            <p class="detail-name">@detail.Name</p>
            <p class="detail-amount @(detail.TransactionType == TransactionType.Income ? "is-income" : null)">@detail.Amount.ToString("C2")</p>
            <dl class="detail-grid">
                <div><dt>Tipo</dt><dd>@TypeLabel(detail.TransactionType)</dd></div>
                <div><dt>Fecha</dt><dd>@detail.Date.ToLocalTime().ToString("dd MMM yyyy")</dd></div>
                <div><dt>Cuenta</dt><dd>@AccountName(detail.FinanceAccountId, detail.FinanceAccountName)</dd></div>
                @if (!string.IsNullOrEmpty(detail.CategoryName)) { <div><dt>Categoría</dt><dd>@detail.CategoryName</dd></div> }
                @if (!string.IsNullOrEmpty(detail.ServiceName)) { <div><dt>Servicio</dt><dd>@detail.ServiceName</dd></div> }
                @if (!string.IsNullOrWhiteSpace(detail.Description)) { <div class="detail-wide"><dt>Descripción</dt><dd>@detail.Description</dd></div> }
            </dl>
            @if (detail.TransferId is not null) { <p class="field-hint">Forma parte de @(detail.TransactionType.IsTransfer() ? "una transferencia entre tus cuentas" : "un pago de tarjeta") con un movimiento vinculado.</p> }
            <div class="operation-actions">
                @if (_planTransactions.Contains(detail.Id)) { <a class="btn btn-secondary" href="planes">Ver compra a meses</a> }
                else { <button class="btn btn-primary" type="button" disabled="@(_busy || !_plansKnown)" @onclick="() => EditAsync(detail.Id)">Editar</button><button class="btn btn-secondary" type="button" disabled="@(_busy || !_plansKnown)" @onclick="() => ConfirmDelete(detail)">Eliminar</button> }
                <button class="btn btn-secondary" type="button" @onclick="Cancel">Cerrar</button>
            </div>
            <AttachmentManager TransactionId="detail.Id" Attachments="detail.Attachments" ReadOnly="true" />
        </section>
    }
    @if (_form is not null)
    {
        <section class="section card operation-form" tabindex="-1" @ref="_panel">
            <h2 class="section-title">@(_id is null ? "Nuevo movimiento" : "Editar movimiento")</h2>
            <EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="transaction">
                <DataAnnotationsValidator /><ValidationSummary />
                <fieldset disabled="@_busy">
                    <label class="field"><span class="field-label">Nombre</span><InputTextLive class="input" @bind-Value="_form.Name" maxlength="50" /></label>
                    <label class="field"><span class="field-label">Descripción</span><InputTextAreaLive class="input" @bind-Value="_form.Description" /></label>
                    <div class="field-row"><label class="field"><span class="field-label">Monto</span><InputNumberLive class="input" @bind-Value="_form.Amount" step="0.01" /></label><label class="field"><span class="field-label">Fecha</span><InputDateLive class="input" @bind-Value="_form.Date" /></label></div>
                    @if (_id is null)
                    {
                        <label class="field"><span class="field-label">Tipo</span><InputSelect class="input" @bind-Value="_form.TransactionType" @bind-Value:after="TypeChanged"><option value="Expense">Gasto</option><option value="Income">Ingreso</option><option value="Payment">Pago de tarjeta</option><option value="TransferIn">Transferencia entre cuentas</option></InputSelect></label>
                        <label class="field"><span class="field-label">@AccountFieldLabel</span><InputSelect class="input" @bind-Value="_form.FinanceAccountId"><option value="">Selecciona…</option>@foreach (var account in SelectableAccounts) { <option value="@account.Id">@account.Label</option> }</InputSelect></label>
                    }
                    else { <p class="field-hint">@_accountName · @TypeLabel(_form.TransactionType). La cuenta y el tipo se conservan.</p> }
                    @if (!_form.TransactionType.IsMovement() && !_linked)
                    {
                        <label class="field"><span class="field-label">Categoría</span><InputSelect class="input" @bind-Value="_form.CategoryId"><option value="">Selecciona…</option>@foreach (var category in _categories.Where(c => !SystemCategories.Contains(c.Name) || c.Id == _form.CategoryId)) { <option value="@category.Id">@category.Name</option> }</InputSelect></label>
                    }
                    @if (_form.TransactionType == TransactionType.Expense && !_linked)
                    {
                        <label class="field"><span class="field-label">Servicio (opcional)</span><InputSelect class="input" @bind-Value="_form.ServiceId"><option value="">Sin servicio</option>@foreach (var service in _services) { <option value="@service.Id">@service.Name</option> }</InputSelect></label>
                    }
                    @if (_id is null && _form.TransactionType == TransactionType.TransferIn)
                    {
                        <label class="field"><span class="field-label">Cuenta de origen</span><InputSelect class="input" @bind-Value="_form.SourceAccountId"><option value="">Selecciona…</option>@foreach (var account in _accounts.Where(x => !x.IsCredit && x.Id != _form.FinanceAccountId)) { <option value="@account.Id">@account.Label</option> }</InputSelect></label>
                        <p class="field-hint">Se registra la salida en la cuenta de origen y la entrada en la de destino. No cuenta como gasto ni como ingreso.</p>
                    }
                    @if (_id is null && _form.TransactionType == TransactionType.Payment)
                    {
                        <label class="field"><span class="field-label">Cuenta de origen (opcional)</span><InputSelect class="input" @bind-Value="_form.SourceAccountId"><option value="">Sin registrar salida en otra cuenta</option>@foreach (var account in _accounts.Where(x => !x.IsCredit)) { <option value="@account.Id">@account.Label</option> }</InputSelect></label>
                        <p class="field-hint">Si eliges una cuenta, también se registra la salida del dinero.</p>
                    }
                    @if (_linked) { <p class="field-hint">Este movimiento forma parte de @(_form.TransactionType.IsTransfer() ? "una transferencia" : "un pago"). Los cambios se aplican también al movimiento vinculado.</p> }
                    <div class="operation-actions"><button class="btn btn-primary" type="submit">@(_busy ? "Guardando…" : "Guardar")</button><button class="btn btn-secondary" type="button" @onclick="Cancel">Cancelar</button></div>
                </fieldset>
            </EditForm>
            <AttachmentManager @ref="_attachmentManager" TransactionId="_id" Attachments="_attachments" Disabled="_busy" OnChanged="FetchAsync" />
        </section>
    }
    <details class="section operation-filters"><summary>Filtrar movimientos</summary>
        <div class="field-row"><label class="field"><span class="field-label">Cuenta</span><InputSelect class="input" @bind-Value="_accountFilter"><option value="">Todas</option>@foreach (var account in _allAccounts) { <option value="@account.Id">@account.Label</option> }</InputSelect></label><label class="field"><span class="field-label">Tipo</span><InputSelect class="input" @bind-Value="_typeFilter"><option value="">Todos</option><option value="Income">Ingresos</option><option value="Expense">Gastos</option><option value="Payment">Pagos</option><option value="TransferIn">Transferencias recibidas</option><option value="TransferOut">Transferencias enviadas</option></InputSelect></label></div>
        <div class="field-row"><label class="field"><span class="field-label">Categoría</span><InputSelect class="input" @bind-Value="_categoryFilter"><option value="">Todas</option>@foreach (var category in _allCategories) { <option value="@category.Id">@category.Name</option> }</InputSelect></label><label class="field"><span class="field-label">Servicio</span><InputSelect class="input" @bind-Value="_serviceFilter"><option value="">Todos</option>@foreach (var service in _allServices) { <option value="@service.Id">@service.Name</option> }</InputSelect></label></div>
        <div class="field-row"><label class="field"><span class="field-label">Desde</span><InputDateLive class="input" @bind-Value="_from" /></label><label class="field"><span class="field-label">Hasta</span><InputDateLive class="input" @bind-Value="_to" /></label></div>
        <button class="btn btn-secondary" type="button" disabled="@_busy" @onclick="ApplyFiltersAsync">Aplicar filtros</button>
    </details>
    @if (_delete is not null)
    {
        <section class="card operation-form" role="alert"><p>¿Eliminar «@_delete.Name»? Esta acción es definitiva.@(_delete.TransferId is null ? "" : " También se elimina el movimiento vinculado.")@(_delete.AttachmentCount == 0 ? "" : " También se eliminan sus comprobantes.")</p><div class="operation-actions"><button class="btn btn-danger" type="button" disabled="@_busy" @onclick="DeleteAsync">Confirmar eliminación</button><button class="btn btn-secondary" type="button" disabled="@_busy" @onclick="() => _delete = null">Cancelar</button></div></section>
    }
    @if (Sync.Pending.Count > 0)
    {
        <h2 class="day-header"><span>Pendientes de sincronizar</span></h2>
        <ul class="list">@foreach (var pending in Sync.Pending)
        {
            <li class="list-item operation-row pending-row" @key="pending.ClientId"><div><p class="list-title">@pending.Body.Name · @pending.Body.Amount.ToString("C2")</p><p class="list-subtitle">@TypeLabel(pending.Body.TransactionType) · @pending.AccountName</p><p class="list-subtitle">@pending.Body.Date.ToLocalTime().ToString("dd MMM yyyy") · @pending.CategoryName @pending.ServiceName</p>@if (pending.Error is null) { <span class="badge badge-warning">Pendiente de sincronizar</span> } else { <span class="badge badge-danger">No se pudo sincronizar</span><p class="list-note">@pending.Error</p> }</div><div class="operation-actions">@if (_discard == pending.ClientId) { <button class="btn btn-danger" type="button" @onclick="() => DiscardAsync(pending.ClientId)">Confirmar</button><button class="btn btn-secondary" type="button" @onclick="() => _discard = null">Cancelar</button> } else { <button class="btn btn-secondary" type="button" @onclick="() => _discard = pending.ClientId">Descartar</button> }</div></li>
        }</ul>
    }
    @if (_page.Items.Count == 0)
    {
        @if (Sync.Pending.Count == 0) { <EmptyState Title="Sin movimientos" Description="Registra un movimiento o ajusta los filtros." /> }
    }
    else
    {
        @* Agrupados por día (en la hora local), como un historial: cada día con su encabezado y lo que se
           gastó. Las acciones (editar, eliminar) viven en el detalle, que se abre al tocar el movimiento. *@
        @foreach (var day in _page.Items.GroupBy(x => DateOnly.FromDateTime(x.Date.ToLocalTime().DateTime)))
        {
            var spent = day.Where(x => x.TransactionType == TransactionType.Expense).Sum(x => x.Amount);
            var earned = day.Where(x => x.TransactionType == TransactionType.Income).Sum(x => x.Amount);
            <section class="day-group" aria-label="@DayLabel(day.Key)">
                <h2 class="day-header">
                    <span>@DayLabel(day.Key)</span>
                    <span class="day-totals">@if (earned > 0) { <span class="tx-in">+@earned.ToString("C2")</span> }@if (spent > 0) { <span>−@spent.ToString("C2")</span> }</span>
                </h2>
                <ul class="tx-list">
                    @foreach (var item in day)
                    {
                        <li class="tx-row is-clickable" role="button" tabindex="0" title="Ver detalle" @key="item.Id"
                            @onclick="() => OpenDetailAsync(item.Id)" @onkeydown="e => OpenDetailByKeyAsync(e, item.Id)">
                            <Glyph Name="@(item.TransactionType.IsMovement() ? TypeLabel(item.TransactionType) : item.CategoryName)" />
                            <div class="tx-main">
                                <p class="tx-name">@item.Name</p>
                                <p class="tx-meta">@(item.TransactionType.IsMovement() ? TypeLabel(item.TransactionType) : item.CategoryName)@(item.ServiceName is null ? "" : $" · {item.ServiceName}") · @AccountName(item.FinanceAccountId, item.FinanceAccountName)</p>
                                @if (_planTransactions.Contains(item.Id) || item.AttachmentCount > 0)
                                {
                                    <p class="tx-tags">@if (_planTransactions.Contains(item.Id)) { <span class="badge badge-neutral">A meses</span> }@if (item.AttachmentCount > 0) { <span class="badge badge-neutral" title="Comprobantes">📎 @item.AttachmentCount</span> }</p>
                                }
                            </div>
                            <span class="tx-amount @AmountClass(item.TransactionType)">@AmountText(item)</span>
                        </li>
                    }
                </ul>
            </section>
        }
        <div class="operation-actions"><button class="btn btn-secondary" disabled="@(_busy || _pageNumber <= 1)" @onclick="() => LoadPageAsync(_pageNumber - 1)">Anterior</button><span>Página @_pageNumber de @_page.TotalPages · @_page.TotalCount movimientos</span><button class="btn btn-secondary" disabled="@(_busy || _pageNumber >= _page.TotalPages)" @onclick="() => LoadPageAsync(_pageNumber + 1)">Siguiente</button></div>
    }
}
@code {
    // Atajo del ícono de la app ("Registrar gasto"): abre el formulario directo.
    [SupplyParameterFromQuery(Name = "nuevo")] private bool Nuevo { get; set; }

    private List<ActiveAccountDto> _accounts = [];
    private List<FinanceAccountListItem> _allAccounts = [];
    private List<CategoryDto> _categories = [], _allCategories = [];
    private List<ServiceDto> _services = [], _allServices = [];
    private PagedTransactions _page = new();
    private TransactionForm? _form;
    private TransactionDto? _detail;
    private ElementReference _panel;
    private bool _focusPanel;
    private TransactionDto? _delete;
    private Guid? _discard;
    private string? _info;
    private List<AttachmentDto> _attachments = [];
    private AttachmentManager? _attachmentManager;
    private readonly HashSet<Guid> _planTransactions = [];
    private bool _plansKnown;
    private Guid? _id, _accountFilter, _categoryFilter, _serviceFilter;
    private TransactionType? _typeFilter;
    private DateTime? _from, _to;
    private int _pageNumber = 1;
    private bool _loading = true, _busy, _linked;
    private string? _error, _accountName;
    // Un pago va a una tarjeta; una transferencia, entre cuentas que no son de crédito.
    private IEnumerable<ActiveAccountDto> SelectableAccounts => _form?.TransactionType switch
    {
        TransactionType.Payment => _accounts.Where(x => x.IsCredit),
        TransactionType.TransferIn => _accounts.Where(x => !x.IsCredit),
        _ => _accounts
    };
    private string AccountFieldLabel => _form?.TransactionType switch
    {
        TransactionType.Payment => "Tarjeta que recibe el pago",
        TransactionType.TransferIn => "Cuenta destino",
        _ => "Cuenta"
    };
    protected override async Task OnInitializedAsync()
    {
        Sync.Changed += OnSyncChanged;
        Sync.Synced += OnSynced;
        var accounts = await Accounts.GetActiveAsync(); var allAccounts = await Accounts.GetAllAsync();
        var categories = await Categories.GetActiveAsync(); var allCategories = await Categories.GetAllAsync();
        var services = await Operations.ServicesAsync(true); var allServices = await Operations.ServicesAsync();
        _accounts = accounts.Data ?? []; _allAccounts = allAccounts.Data ?? [];
        _categories = categories.Data ?? []; _allCategories = allCategories.Data ?? [];
        _services = services.Data ?? []; _allServices = allServices.Data ?? [];
        var plans = await Operations.PlansAsync();
        _plansKnown = plans.Success;
        if (plans.Success)
        {
            var details = await Task.WhenAll((plans.Data ?? []).Select(x => Operations.PlanAsync(x.Id)));
            _plansKnown = details.All(x => x.Success && x.Data is not null);
            foreach (var detail in details.Where(x => x.Success && x.Data is not null)) _planTransactions.Add(detail.Data!.TransactionId);
        }
        await LoadPageAsync(1);
        if (!_plansKnown) _error ??= "No se pudo verificar qué movimientos pertenecen a compras a meses. Recarga para editarlos.";
        _error ??= accounts.Error ?? allAccounts.Error ?? categories.Error ?? allCategories.Error ?? services.Error ?? allServices.Error;
        if (new[] { accounts.FromCache, categories.FromCache, services.FromCache }.Any(x => x))
        {
            // Sin conexión pero con datos guardados: se puede registrar; no es un error de compras a meses.
            _info = "Sin conexión: se muestran los últimos datos guardados en este dispositivo.";
            if (!_plansKnown && _error?.StartsWith("No se pudo verificar") == true) _error = null;
        }
        _loading = false;
        if (Nuevo) New();
    }
    private void New() { _id = null; _linked = false; _form = new(); _attachments = []; _error = null; _delete = null; _detail = null; _focusPanel = true; }
    private void Cancel() { _form = null; _id = null; _attachments = []; _detail = null; }

    // El detalle y el formulario se muestran arriba de la lista: se enfocan para que el navegador los
    // traiga a la vista aunque la tarjeta tocada esté más abajo.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPanel || (_detail is null && _form is null)) return;
        _focusPanel = false;
        try { await _panel.FocusAsync(); } catch (JSException) { }
    }

    private async Task OpenDetailAsync(Guid id)
    {
        if (_busy) return;
        _busy = true; _error = null;
        try
        {
            var result = await Operations.TransactionAsync(id);
            if (!result.Success || result.Data is null) { _error = result.Error; return; }
            Cancel(); _delete = null;
            _detail = result.Data; _focusPanel = true;
        }
        finally { _busy = false; }
    }

    private async Task OpenDetailByKeyAsync(KeyboardEventArgs e, Guid id)
    {
        if (e.Key is "Enter" or " ") await OpenDetailAsync(id);
    }

    private void ConfirmDelete(TransactionDto detail)
    {
        detail.AttachmentCount = Math.Max(detail.AttachmentCount, detail.Attachments.Count);
        _delete = detail;
    }
    private void TypeChanged() { if (_form is null) return; _form.FinanceAccountId = null; _form.CategoryId = null; _form.ServiceId = null; _form.SourceAccountId = null; }
    private async Task EditAsync(Guid id)
    {
        if (_busy) return;
        _busy = true; _error = null;
        try
        {
            var result = await Operations.TransactionAsync(id);
            if (!result.Success || result.Data is null) { _error = result.Error; return; }
            var item = result.Data; _detail = null; _focusPanel = true; _id = id; _linked = item.TransferId is not null; _accountName = AccountName(item.FinanceAccountId, item.FinanceAccountName); _attachments = item.Attachments;
            _form = new() { Name = item.Name, Description = item.Description, Amount = item.Amount, Date = item.Date.LocalDateTime, TransactionType = item.TransactionType, FinanceAccountId = item.FinanceAccountId, CategoryId = item.CategoryId, ServiceId = item.ServiceId, Version = item.Version };
            if (!_categories.Any(x => x.Id == item.CategoryId)) _categories.Add(new() { Id = item.CategoryId, Name = item.CategoryName });
            if (item.ServiceId is Guid serviceId && !_services.Any(x => x.Id == serviceId)) _services.Add(new() { Id = serviceId, Name = item.ServiceName ?? "Servicio archivado" });
            _delete = null;
        }
        finally { _busy = false; }
    }
    private async Task SaveAsync()
    {
        if (_busy || _form is null) return;
        if (_form.FinanceAccountId is null || _form.FinanceAccountId == Guid.Empty) { _error = "Selecciona una cuenta."; return; }
        if (!_form.TransactionType.IsMovement() && !_linked && (_form.CategoryId is null || _form.CategoryId == Guid.Empty)) { _error = "Selecciona una categoría."; return; }
        if (_id is null && _form.TransactionType == TransactionType.TransferIn && (_form.SourceAccountId is null || _form.SourceAccountId == _form.FinanceAccountId)) { _error = "Elige una cuenta de origen distinta a la de destino."; return; }
        _busy = true; _error = null;
        Guid? created = null; string? attachmentError = null;
        // El id del cliente hace que reenviar el alta (p. ej. desde la cola sin conexión) no la duplique.
        var clientId = _id is null ? Guid.NewGuid() : (Guid?)null;
        try
        {
            var result = await Operations.SaveTransactionAsync(_form, _id, clientId);
            if (result.Success)
            {
                // Los comprobantes de un movimiento nuevo se suben ya que existe en el servidor.
                if (_id is null && result.Data is not null && _attachmentManager?.HasStaged == true)
                {
                    created = result.Data.Id;
                    attachmentError = await _attachmentManager.UploadStagedAsync(created.Value);
                }
                Cancel(); await FetchAsync();
            }
            else if (result.StatusCode == 0 && clientId is Guid offlineId) await QueueOfflineAsync(offlineId);
            else _error = result.Error + " " + string.Join(" ", result.ValidationErrors.Values.SelectMany(x => x)) + (result.StatusCode == 409 && result.Error?.Contains("MSI") == true ? " Adminístrala desde Compras a meses." : "");
        }
        finally { _busy = false; }
        // Si algún comprobante falló, se abre el movimiento ya guardado para reintentar desde ahí.
        if (attachmentError is not null && created is Guid id)
        {
            await EditAsync(id);
            _error = "El movimiento se guardó, pero " + char.ToLower(attachmentError[0]) + attachmentError[1..];
        }
    }
    private async Task DeleteAsync()
    {
        if (_busy || _delete is null) return;
        _busy = true; _error = null;
        try
        {
            var result = await Operations.DeleteTransactionAsync(_delete.Id);
            if (result.Success) { _delete = null; Cancel(); await FetchAsync(); }
            else _error = result.Error + (result.StatusCode == 409 ? " Administra esta compra desde Compras a meses." : "");
        }
        finally { _busy = false; }
    }
    // Sin conexión el movimiento se guarda en el dispositivo y OfflineSync lo envía después.
    private async Task QueueOfflineAsync(Guid clientId)
    {
        if (_form is null) return;
        if (_form.TransactionType.IsMovement())
        {
            _error = "Los pagos y las transferencias necesitan conexión. Regístralos cuando vuelva la red.";
            return;
        }

        await Sync.EnqueueAsync(new PendingTransaction
        {
            ClientId = clientId,
            Body = OperationsService.NewTransaction(_form, clientId),
            AccountName = _accounts.FirstOrDefault(x => x.Id == _form.FinanceAccountId)?.Label ?? "",
            CategoryName = _categories.FirstOrDefault(x => x.Id == _form.CategoryId)?.Name,
            ServiceName = _services.FirstOrDefault(x => x.Id == _form.ServiceId)?.Name,
            QueuedAt = DateTimeOffset.UtcNow
        });

        var hadAttachments = _attachmentManager?.HasStaged == true;
        Cancel();
        _info = "Sin conexión: el movimiento se guardó en este dispositivo y se enviará al volver la conexión."
                + (hadAttachments ? " Los comprobantes no se guardan sin conexión; adjúntalos cuando se sincronice." : "");
    }

    private async Task DiscardAsync(Guid clientId)
    {
        _discard = null;
        await Sync.DiscardAsync(clientId);
    }

    private void OnSyncChanged() => InvokeAsync(StateHasChanged);

    // Lo que estaba en la cola ya es un movimiento real: se recarga la lista para mostrarlo.
    private void OnSynced() => InvokeAsync(async () =>
    {
        _info = null;
        await FetchAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Sync.Changed -= OnSyncChanged;
        Sync.Synced -= OnSynced;
    }

    private async Task ApplyFiltersAsync() => await LoadPageAsync(1);
    private async Task LoadPageAsync(int page)
    {
        if (_busy) return;
        if (_from > _to) { _error = "La fecha inicial debe ser anterior a la final."; return; }
        _busy = true; _error = null; _pageNumber = page;
        try { await FetchAsync(); } finally { _busy = false; }
    }
    private async Task FetchAsync()
    {
        var result = await Operations.TransactionsAsync(_pageNumber, _accountFilter, _categoryFilter, _serviceFilter, _typeFilter, _from, _to);
        if (!result.Success) { _error = result.Error; return; }
        if (result.FromCache) _info ??= "Sin conexión: se muestran los últimos datos guardados en este dispositivo.";
        _page = result.Data ?? new();
        if (_pageNumber > 1 && _page.Items.Count == 0) { _pageNumber--; await FetchAsync(); }
    }
    // _allAccounts incluye las archivadas, así que todo movimiento encuentra su banco.
    private string AccountName(Guid id, string fallback) => _allAccounts.FirstOrDefault(a => a.Id == id)?.Label ?? fallback;

    private static string DayLabel(DateOnly day)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var name = day == today ? "Hoy" : day == today.AddDays(-1) ? "Ayer" : day.ToString(day.Year == today.Year ? "dddd d 'de' MMMM" : "dddd d 'de' MMMM yyyy");
        return char.ToUpper(name[0]) + name[1..];
    }

    private static string? AmountClass(TransactionType type) => type switch
    {
        TransactionType.Income => "tx-in",
        TransactionType.Payment or TransactionType.TransferIn or TransactionType.TransferOut => "tx-transfer",
        _ => null
    };

    // Ingreso con +, gasto con −; un pago solo mueve dinero entre cuentas y va sin signo.
    private static string AmountText(TransactionDto item) => item.TransactionType switch
    {
        TransactionType.Income => "+" + item.Amount.ToString("C2"),
        TransactionType.Expense => "−" + item.Amount.ToString("C2"),
        // Una transferencia mueve dinero propio: lleva signo para saber si entró o salió, pero en gris.
        TransactionType.TransferIn => "+" + item.Amount.ToString("C2"),
        TransactionType.TransferOut => "−" + item.Amount.ToString("C2"),
        _ => item.Amount.ToString("C2")
    };

    private static string TypeLabel(TransactionType type) => type switch
    {
        TransactionType.Income => "Ingreso",
        TransactionType.Payment => "Pago de tarjeta",
        TransactionType.TransferIn => "Transferencia recibida",
        TransactionType.TransferOut => "Transferencia enviada",
        _ => "Gasto"
    };
}
